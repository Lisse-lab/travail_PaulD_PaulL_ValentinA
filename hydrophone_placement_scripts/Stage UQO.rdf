        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Downs</foaf:surname>
                        <foaf:givenName>Joni A.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Horner</foaf:surname>
                        <foaf:givenName>Mark W.</foaf:givenName>
                    </foaf:Person>
