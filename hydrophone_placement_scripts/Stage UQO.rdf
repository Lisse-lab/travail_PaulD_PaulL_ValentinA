            <dcterms:URI>
                <rdf:value>https://www.sciencedirect.com/science/article/pii/S1574954108000654</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2025-07-23 13:21:21</dcterms:dateSubmitted>
        <bib:pages>34-41</bib:pages>
    </bib:Article>
