        </dc:subject>
        <dc:subject>
            <z:AutomaticTag>
               <rdf:value>Theoretical and Statistical Ecology</rdf:value>
            </z:AutomaticTag>
        </dc:subject>
        <dc:subject>
            <z:AutomaticTag>
               <rdf:value>Time Series Analysis</rdf:value>
            </z:AutomaticTag>
        </dc:subject>
        <dc:subject>
           <z:AutomaticTag><rdf:value>Tracking data</rdf:value></z:AutomaticTag>
